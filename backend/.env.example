# CPARAS Platform (CPARAS Bulk + CPARAS ISLD) — backend configuration
# Copy to .env (the setup scripts do this) and edit. .env is never committed.
# Every setting and its default is documented in core/config.py.
# Unknown keys are ignored.

# ── Server ────────────────────────────────────────────────────────────────
# 127.0.0.1 keeps the API on this machine only. Since v0.5.0 every API call
# also requires a signed-in user (see the Authentication section below).
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Local LLM ─────────────────────────────────────────────────────────────
# Options: ollama (default) | llamacpp | vllm
LLM_BACKEND=ollama
# Use 127.0.0.1, not "localhost" (on Windows "localhost" may try IPv6 first,
# while Ollama listens on IPv4). Check it in a browser: http://127.0.0.1:11434/api/tags
# should show a JSON list of your models. If this line is removed, Ollama's
# own OLLAMA_HOST variable is used when set.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default TEXT model. Must appear in `ollama list`. Tested: qwen2.5:7b,
# qwen2.5:3b, phi3.5:3.8b-mini-instruct-q4_K_M. Never use a vision model
# (moondream) here. A missing model is reported, never silently replaced.
OLLAMA_MODEL=qwen2.5:7b
# Seconds allowed for one generation request.
OLLAMA_TIMEOUT=1800
# MAXIMUM context window (tokens) per call. Since v0.4.2 the backend lowers
# it per model so the model stays entirely on the GPU (long documents are
# then split into smaller chunks). See OLLAMA_FIT_CONTEXT_TO_GPU below.
OLLAMA_NUM_CTX=24576
# Max simultaneous requests to Ollama. 1 = sequential (safe). Raise only
# with spare VRAM AND OLLAMA_NUM_PARALLEL set to the same value for Ollama.
OLLAMA_CONCURRENCY=1

# ── GPU fit & reproducibility (v0.4.2) ────────────────────────────────────
# true = size the context per model so weights + KV cache fit in VRAM
# (keeps Ollama on the GPU, prevents the HTTP 500 "out of memory" with
# phi3.5). false = always send OLLAMA_NUM_CTX (v0.4.1 behaviour).
OLLAMA_FIT_CONTEXT_TO_GPU=true
OLLAMA_MIN_NUM_CTX=8192
# VRAM kept free for Windows / the browser on the same GPU.
GPU_VRAM_RESERVE_GB=0.8
# Passed to the Ollama SERVER by start.ps1 / start.sh (and stored for the
# Ollama tray app by setup.ps1). Halves the context's memory; required for
# phi3.5 on a 4-6 GB card. Restart Ollama after changing these.
OLLAMA_FLASH_ATTENTION=true
OLLAMA_KV_CACHE_TYPE=q8_0
# Fixed seed: the same file gives the same result on every run.
OLLAMA_SEED=42
# Keep the model loaded between requests (no reload between files).
OLLAMA_KEEP_ALIVE=30m

# ── OCR (scanned PDFs) ────────────────────────────────────────────────────
# Tesseract is found automatically on PATH and in
# C:\Program Files\Tesseract-OCR. Only set this for another location, e.g.
# TESSERACT_CMD=D:\Tools\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
TESSERACT_DPI_SCALE=4.17
TESSERACT_PSM=6
TESSERACT_PAGE_TIMEOUT=120
# Vision-model OCR fallback, only used when Tesseract is unavailable.
# Install with: ollama pull moondream
VISION_MODEL=moondream
VISION_OCR_MAX_PAGES=60

# ── Embeddings (sentence-transformers, local) ─────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
# auto = NVIDIA GPU (CUDA) when PyTorch can use it, else CPU. cpu = always CPU.
EMBEDDING_DEVICE=auto
# false = never download at runtime (offline). The setup script downloads
# the model once; set true to allow a one-time download while online.
EMBEDDING_ALLOW_DOWNLOAD=false

# ── Vector store ──────────────────────────────────────────────────────────
# chromadb (embedded, default) | qdrant (needs a Qdrant server) | faiss
VECTOR_BACKEND=chromadb
CHROMADB_PATH=./data/chromadb
QDRANT_URL=http://127.0.0.1:6333

# ── Database (relative paths are inside backend/) ─────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/sep_intel.db

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── CPARAS Bulk scoring (large ETSI workbooks) ────────────────────────────
# Rows embedded/scored per batch; lower (64-128) on low-memory machines.
SCORING_BATCH_SIZE=256
SCORING_DB_COMMIT_BATCH_SIZE=250

# ── Patent title lookup (optional) — https://developers.epo.org ───────────
EPO_OPS_KEY=
EPO_OPS_SECRET=

# ── 3GPP archive crawler (Standards Corpus page; needs internet) ───────────
THREEGPP_BASE_URL=https://www.3gpp.org/ftp/specs/archive/
CRAWLER_REQUEST_TIMEOUT=60
CRAWLER_MAX_RETRIES=3
CRAWLER_THROTTLE_SECONDS=0.3

# ── Extra browser origins allowed by CORS (comma-separated) ───────────────
CORS_EXTRA_ORIGINS=

# ── Authentication & roles (v0.5.0) — see docs/AUTH.md ───────────────────
# Roles: guest (CPARAS ISLD only), data_entry (ISLD + Bulk), super_admin (all +
# user management). Create the first Super Admin with create_admin.cmd
# (Windows) / ./create_admin.sh, or "First-time setup" in the browser using the
# one-time token file below. There are no default accounts or passwords.
# Signed out after this many minutes without activity / absolute maximum (hours):
AUTH_SESSION_IDLE_MINUTES=480
AUTH_SESSION_MAX_HOURS=72
# true only when the app is served over HTTPS (cookie then never sent over plain HTTP):
AUTH_COOKIE_SECURE=false
AUTH_PASSWORD_MIN_LENGTH=10
# Failed sign-ins (per username + computer) before a temporary lock-out, and its length:
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_MINUTES=10
# Written while no account exists; deleted once the first Super Admin is created:
AUTH_SETUP_TOKEN_FILE=./data/FIRST_ADMIN_SETUP_TOKEN.txt

# ── Validated 3GPP dataset (optional; READ-ONLY) ──────────────────────────
# Dataset build folder = the folder that contains etsi_dataset.jsonl and etsi_dataset.zip, e.g.
#   CPARAS_DATASET_ROOT=D:\3gpp\cparas_dataset\build_v4
# setup.ps1 fills this in automatically when the dataset sits next to the app folders.
CPARAS_DATASET_ROOT=
# CPARAS Bulk reference corpus: auto = standards_corpus_3gpp.json from the dataset when available,
# otherwise the built-in illustrative corpus | retrieval = require the SQLite index | dataset = require it | illustrative = never use it.
BULK_CORPUS_SOURCE=auto

# ── Memory-bounded embedding / indexing (v0.4.4.1) ─────────────────────────
# Attention memory grows with batch x heads x tokens^2, so one huge chunk in a batch of 32 can ask for GBs.
# Longest sequence (tokens) the importer feeds the model; longer chunks are split into numbered parts.
EMBEDDING_MAX_SEQ_LENGTH=1024
# Texts per forward pass on CPU, and the planned working memory per pass (model weights are extra; 0 = auto).
EMBEDDING_CPU_BATCH_SIZE=8
EMBEDDING_MEMORY_BUDGET_MB=1536
# Chunks embedded + written per group (only one group of vectors is ever in RAM).
ETSI_INDEX_GROUP_CHUNKS=64
# Importer waits, then fails the document as retryable, below this much free RAM (MB; 0 = off). 
ETSI_MIN_FREE_RAM_MB=768
# Documents above this many characters are reported as failed (document_too_large) - never skipped silently. 0 = no ceiling.
ETSI_MAX_DOC_CHARS=60000000

# ── SQLite/FTS5 retrieval index as the dataset (optional; READ-ONLY; v0.4.6) ──
# The `retrieval_data` folder written by tgpp-sqlite-retrieval (search_index.sqlite, manifest.json, schema_version.json ...).
# DEFAULT LOCATION: leave this EMPTY and copy the folder's files into  <project>\dist\retrieval_data\
# (next to backend\ and frontend\). The backend finds them there automatically.
# Set a path only to use a copy elsewhere (e.g. one copy shared with Initial Categoriser):
#   CPARAS_RETRIEVAL_DATA=D:\3gpp\tgpp-sqlite-retrieval\dist\retrieval_data
CPARAS_RETRIEVAL_DATA=
# auto = use the index when configured and usable, else the vector store | sqlite | vector | both
RETRIEVAL_SOURCE=auto
# FTS5 candidates per query that the application's embedder then re-scores (recall vs. speed)
RETRIEVAL_SQLITE_POOL=24
# true = re-score with the embedder (semantic scores); false = lexical only (never counted as semantic evidence)
RETRIEVAL_SQLITE_RERANK=true
# CPARAS Bulk corpus built from the index (BULK_CORPUS_SOURCE=auto|retrieval|dataset|illustrative; set `retrieval` to require it)
BULK_RETRIEVAL_VERSIONS=latest-per-release
BULK_RETRIEVAL_MAX_DEPTH=3
BULK_RETRIEVAL_MAX_CHARS=1500
BULK_RETRIEVAL_MIN_CHARS=40
BULK_RETRIEVAL_MAX_ENTRIES=250000

# ── Speed (v0.4.7) ────────────────────────────────────────────────────────
# fp16 embeddings on an NVIDIA GPU / int8 on CPU (auto = on, false = fp32)
EMBEDDING_FP16=auto
EMBEDDING_CPU_INT8=auto
# Vectors kept in memory for repeated search/scoring texts (0 = off)
EMBEDDING_CACHE_SIZE=50000
# Load the embedding model, retrieval index and Bulk corpus in the background at startup
WARMUP_ON_STARTUP=true
# Bulk scoring: auto = shortlist until every clause vector is cached, then exhaustive | exhaustive | shortlist
BULK_SCORING_STRATEGY=auto
# After a run, embed the remaining clauses in the background: auto = only on a GPU | true | false
BULK_CORPUS_PRECOMPUTE=auto
BULK_CORPUS_EMBED_MAX_TOKENS=160
# Shortlist sizes (first runs only - exhaustive once every clause vector is cached)
BULK_SHORTLIST_GLOBAL=16
BULK_SHORTLIST_DECLARED=24
BULK_SHORTLIST_TITLES=8
# ISLD: characters of each retrieval candidate the embedder reads; remember LLM enrichment answers
RETRIEVAL_RERANK_MAX_CHARS=1000
ISLD_ENRICH_CACHE=true
